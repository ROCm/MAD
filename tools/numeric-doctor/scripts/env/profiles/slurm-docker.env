# A Slurm cluster with docker on the compute nodes.  Copy this file for your site and set
# SLURM_ARGS (account, partition, ...).  SLURM_GPUS_FLAG stays empty where nodes come whole
# (no GPU gres); set it to "--gpus-per-node={n}" where Slurm schedules GPUs.
SCHED=slurm
SLURM_ARGS=""
SLURM_GPUS_FLAG=
RUNTIME=docker
DOCKER_PULL=1
DOCKER_AS_USER=1
