# A Slurm cluster with apptainer (no docker).  Copy this file for your site and set SLURM_ARGS
# (account, partition, ...) and SIF_DIR (where SIF images are kept).  If the project dir must be
# bound at another path in the container (a read-only SIF cannot mount the host path), set PROJ
# and CONTAINER_PROJ.  SINGLE_SESSION=1 where a login allows only one SSH session: nd wait then
# refuses a blocking wait -- one-shot `nd status` checks instead.
SCHED=slurm
SLURM_ARGS=""
SLURM_GPUS_FLAG="--gpus-per-node={n}"   # for sites that accept no job without a GPU request
RUNTIME=apptainer
APPTAINER_FLAGS="--pid"
