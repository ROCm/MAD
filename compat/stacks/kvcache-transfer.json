{
  "name": "kvcache-transfer",
  "description": "KV-cache transfer backends (MoRI, Mooncake, UCX/NIXL) on the SGLang ROCm 10 image; lock form of docker/kvcache_transfer_bench",
  "owner": "mad.support@amd.com",
  "platform": {
    "vendor": "AMD",
    "rocm": "10",
    "python": null,
    "gpu_arch": ["gfx942"],
    "nic": []
  },
  "base": "lmsysorg/sglang:v0.5.20-rocm10-mi30x",
  "setup": ["sed -i 's|http://|https://|g' /etc/apt/sources.list"],
  "system_packages": [
    "ibverbs-utils", "libibverbs-dev", "openmpi-bin", "libopenmpi-dev", "libpci-dev",
    "libdw1", "locales", "libgrpc-dev", "libgrpc++-dev", "libprotobuf-dev",
    "protobuf-compiler-grpc", "cmake", "libdrm-dev"
  ],
  "env": {
    "MORI_ROOT": "/sgl-workspace/mori",
    "MORI_IO_BENCH_ENGINE_BIN": "/sgl-workspace/mori/build_bench/tests/cpp/bench_engine",
    "MOONCAKE_HOME": "/sgl-workspace/Mooncake",
    "UCX_HOME": "/sgl-workspace/ucx",
    "NIXL_HOME": "/sgl-workspace/nixl",
    "PYTHONPATH": "/sgl-workspace/mori:/sgl-workspace/aiter",
    "PATH": "/sgl-workspace/ucx/bin:${PATH}:/usr/local/bin/etcd",
    "LD_LIBRARY_PATH": "/sgl-workspace/nixl/lib/x86_64-linux-gnu:/sgl-workspace/ucx/lib:${LD_LIBRARY_PATH}"
  },
  "sources": [
    {
      "name": "mori",
      "note": "v1.2.3.post1. Python package and the MoRI-IO C++ bench_engine from one checkout.",
      "repo": "https://github.com/ROCm/mori.git",
      "commit": "67632e80e2e492184b589904b63225f82d45537c",
      "path": "/sgl-workspace/mori",
      "steps": [
        "pip install -r requirements-build.txt Cython",
        "MORI_GPU_ARCHS=\"${GPU_ARCH_LIST:-{gpu_arch}}\" pip install --no-build-isolation -e .",
        "cmake -B build_bench -DCMAKE_PREFIX_PATH=\"${ROCM_PATH:-/opt/rocm}/lib/rocm_sysdeps\" -DUSE_ROCM=ON -DCMAKE_BUILD_TYPE=Release -DGPU_TARGETS=\"${GPU_ARCH_LIST:-{gpu_arch}}\" -DBUILD_IO=ON -DBUILD_TESTS=ON -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARK=OFF -DBUILD_UMBP=OFF -DWITH_MPI=OFF -DBUILD_XLA_FFI_OPS=OFF",
        "cmake --build build_bench --target bench_engine -j $(nproc)",
        "${MORI_IO_BENCH_ENGINE_BIN} --help > /dev/null"
      ]
    },
    {
      "name": "mooncake",
      "note": "v0.3.13.post1. ENABLE_MULTI_PROTOCOL=ON is required with USE_HIP=ON; without it cross-node writes go to HIP IPC and fail.",
      "repo": "https://github.com/kvcache-ai/Mooncake.git",
      "commit": "719735896c86b56fabec6cf3e825fb2ea640597a",
      "path": "/sgl-workspace/Mooncake",
      "steps": [
        "rm -rf /usr/local/go",
        "bash dependencies.sh -y",
        "mkdir build && cd build && cmake .. -DBUILD_SHARED_LIBS=ON -DUSE_HIP=ON -DENABLE_MULTI_PROTOCOL=ON -DUSE_HTTP=ON -DUSE_ETCD=ON -DSTORE_USE_ETCD=ON -DBUILD_UNIT_TESTS=OFF && make -j16 && make install",
        "pip install uv && uv venv --seed /tmp/mooncake-wheel-venv",
        "PATH=\"/tmp/mooncake-wheel-venv/bin:${PATH}\" LD_LIBRARY_PATH=\"${MOONCAKE_HOME}/build/mooncake-asio:${LD_LIBRARY_PATH}\" ./scripts/build_wheel.sh",
        "rm -rf /tmp/mooncake-wheel-venv",
        "pip uninstall -y mooncake-transfer-engine mooncake-transfer-engine-non-cuda",
        "rm -rf \"$(python3 -c 'import sysconfig; print(sysconfig.get_paths()[\"purelib\"])')/mooncake\"",
        "pip install --no-cache-dir mooncake-wheel/dist/*.whl",
        "python3 -c 'from mooncake.engine import TransferEngine'",
        "cp build/mooncake-transfer-engine/benchmark/tebench /usr/local/bin/"
      ]
    },
    {
      "name": "ucx",
      "repo": "https://github.com/ROCm/ucx.git",
      "commit": "da3fac2a",
      "path": "/sgl-workspace/ucx",
      "steps": [
        "if dpkg -s libabsl-dev >/dev/null 2>&1; then apt-get remove -y libabsl-dev; fi",
        "./autogen.sh",
        "mkdir build && cd build && ../configure --prefix=${UCX_HOME} --enable-shared --disable-static --disable-doxygen-doc --enable-optimizations --enable-devel-headers --with-rocm=/opt/rocm --with-verbs --with-dm --enable-mt --without-go && make -j && make install"
      ]
    },
    {
      "name": "nixl",
      "note": "v1.4.1 plus ai-dynamo/nixl#2191 (ROCm fix, not in v1.4.1). Replaces any NIXL the base ships.",
      "repo": "https://github.com/ai-dynamo/nixl.git",
      "commit": "778edd1d1a50936b12c264879e12ef465e629002",
      "cherry_pick": ["fe3244c875ee4a22da6b0140c94c334546e9b715"],
      "path": "/sgl-workspace/nixl",
      "steps": [
        "pip install meson meson-python patchelf tomlkit uv",
        "pip uninstall -y nixl nixl-rocm nixl-cu12 nixl-cu13",
        "SITE=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()[\"purelib\"])') && rm -rf \"$SITE/nixl\" \"$SITE/nixl_rocm\"",
        "meson setup build --prefix=${NIXL_HOME} -Ducx_path=${UCX_HOME} -Dwheel_variant=rocm -Denable_plugins=UCX",
        "ninja -C build install",
        "./contrib/tomlutil.py --wheel-name nixl-rocm pyproject.toml",
        "pip install --no-cache-dir --no-build-isolation . -Csetup-args=-Ducx_path=${UCX_HOME} -Csetup-args=-Dwheel_variant=rocm -Csetup-args=-Denable_plugins=UCX",
        "pip install --no-cache-dir --no-deps build/src/bindings/python/nixl-meta/nixl-*-py3-none-any.whl",
        "python3 -c \"from nixl._api import nixl_agent, nixl_agent_config; assert 'UCX' in nixl_agent('probe', nixl_agent_config(backends=[])).get_plugin_list()\"",
        "wget -q https://github.com/etcd-io/etcd/releases/download/v3.6.0-rc.5/etcd-v3.6.0-rc.5-linux-amd64.tar.gz -O /tmp/etcd.tar.gz",
        "mkdir -p /usr/local/bin/etcd && tar -xf /tmp/etcd.tar.gz -C /usr/local/bin/etcd --strip-components=1 && rm /tmp/etcd.tar.gz"
      ]
    }
  ],
  "validated": null
}
