{% extends "base.html.j2" %}
{% import "macros.html.j2" as ui with context %}
{% block title %}QA coverage — MAD Recipes{% endblock %}
{% block body %}
<main class="wrap">
  {{ ui.page_header("QA coverage", "What a MAD run verifies today, and what it does not.", snap, glyph="shield") }}
  <section>
    <div class="split">
      <div class="card">
        <h3><span class="status good">Covered</span></h3>
        {{ ui.qa_list(snap.qa.covered) }}
      </div>
      <div class="card">
        <h3><span class="status critical">Not covered</span></h3>
        {{ ui.qa_list(snap.qa.not_covered) }}
      </div>
    </div>
    <p class="faint" style="font-size:12.5px">Performance, multi-node, Kubernetes, opt-in and needle-in-a-haystack coverage are derived from the model registry; the other statements are maintained in <code>dashboard/status.yaml</code>.</p>
  </section>
</main>
{% endblock %}
