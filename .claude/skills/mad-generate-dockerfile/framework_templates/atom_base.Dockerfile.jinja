ARG BASE_DOCKER={{ base_image | default('rocm/atom-dev:latest') }}
FROM $BASE_DOCKER

USER root
ENV WORKSPACE_DIR=/workspace
RUN mkdir -p $WORKSPACE_DIR
WORKDIR $WORKSPACE_DIR

{% if apt_packages %}
RUN apt update && apt install -y {{ apt_packages | map('shquote') | join(' ') }} \
    && rm -rf /var/lib/apt/lists/*
{% endif %}

{% if pip_packages %}
RUN pip install --no-cache-dir {{ pip_packages | map('shquote') | join(' ') }}
{% endif %}

{% if git_repos %}
{% for repo in git_repos %}
RUN git clone {{ repo.url | shquote }} {{ repo.path | shquote }}
{% if repo.checkout %}
RUN cd {{ repo.path | shquote }} && git checkout {{ repo.checkout | shquote }}
{% endif %}
{% endfor %}
{% endif %}

# record configuration for posterity
RUN pip3 list

{% if custom_entrypoint %}
# Specify entrypoint to override upstream
ENTRYPOINT [""]
{% endif %}
