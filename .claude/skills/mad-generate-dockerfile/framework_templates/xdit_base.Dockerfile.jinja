ARG BASE_DOCKER={{ base_image | default('rocm/pytorch-xdit:v26.7') }}
FROM ${BASE_DOCKER} AS base

# No WORKDIR override: keep the upstream xDiT image's default, as
# docker/pyt_xdit.ubuntu.amd.Dockerfile does.
USER root

RUN apt-get update && apt install -y lshw{% if apt_packages %} {{ apt_packages | join(' ') }}{% endif %} \
    && rm -rf /var/lib/apt/lists/*

{% if pip_packages %}
RUN pip install --no-cache-dir {{ pip_packages | join(' ') }}
{% endif %}

{% if git_repos %}
{% for repo in git_repos %}
RUN git clone {{ repo.url }} {{ repo.path }}
{% if repo.checkout %}
RUN cd {{ repo.path }} && git checkout {{ repo.checkout }}
{% endif %}
{% endfor %}
{% endif %}

# record configuration for posterity
RUN pip3 list
