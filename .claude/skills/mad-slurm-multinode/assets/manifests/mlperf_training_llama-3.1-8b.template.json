      "/npy_index": "<FILL_DATA_ROOT>/llama3_1_8b/npy_index"
    },
    "docker_build_arg": {
      "BASE_DOCKER": "rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0",
