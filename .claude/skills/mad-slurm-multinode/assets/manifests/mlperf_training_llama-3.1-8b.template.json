      "NCCL_IB_HCA": "<FILL_NCCL_IB_HCA  data-plane HCA list, see references/cluster-types.md>",
      "NCCL_IB_GID_INDEX": "<FILL_GID  RoCEv2 GID index, see references/cluster-types.md>",
      "NCCL_SOCKET_IFNAME": "<FILL_IFNAME  management iface, see references/cluster-types.md>",
      "GLOO_SOCKET_IFNAME": "<FILL_IFNAME  management iface, see references/cluster-types.md>",
      "RDMAV_DRIVERS": "<FILL_DRIVER  see references/cluster-types.md>",
      "IBV_DRIVERS": "<FILL_DRIVER  see references/cluster-types.md>",
      "RCCL_AINIC_ROCE": "<FILL_RCCL_AINIC_ROCE  per archetype, see references/cluster-types.md; delete this key if not needed>",
      "IBV_SHOW_WARNINGS": "1",
      "MLPERF_EXECUTION_MODE": "torchrun_in_alloc",
      "MLPERF_TRAINING_REF": "d15c39403c20786633aac6876c014b074a22feb9",
      "MLPERF_GBS": "64",
      "MLPERF_MBS": "1",
      "MLPERF_MAX_STEPS": "100",
      "MLPERF_WARMUP_STEPS": "2",
      "MLPERF_EVAL_EVERY": "65536",
      "MLPERF_TARGET_LOG_PPL": "3.3",
      "MLPERF_PEAK_BF16_TFLOPS": "<FILL_PEAK_BF16  dense BF16 matrix peak of ONE GPU in TFLOP/s: 2500 = MI355X, 1307 = MI300X/MI325X; drives mfu_pct only>",
      "PYTORCH_HIP_ALLOC_CONF": "expandable_segments:True",
      "PREPROCESSED_PATH": "/preproc_data",
      "TOKENIZER_PATH": "/tokenizer",
      "CONTINUAL_CKPT": "/continual",
      "TMP_NPY_INDEX": "/npy_index"
    },
    "docker_mounts": {
      "/dev/infiniband": "/dev/infiniband",
      "/preproc_data": "<FILL_DATA_ROOT>/llama3_1_8b/preprocessed",
      "/tokenizer": "<FILL_DATA_ROOT>/llama3_1_8b/tokenizer",
