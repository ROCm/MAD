      "dockerfile": "docker/pyt_mlperf_training.ubuntu.amd.Dockerfile",
      "base_docker": "rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0",
      "build_duration": 0,
      "local_image": true,
      "registry_image": null,
      "registry": null,
      "gpu_vendor": "AMD"
    }
  },
  "built_models": {
    "rocm-mlperf-training-llama31-8b": {
      "name": "pyt_mlperf_training_llama-3.1-8b",
      "url": "https://github.com/mlcommons/training",
      "dockerfile": "docker/pyt_mlperf_training",
      "scripts": "scripts/pyt_mlperf_training/run.sh",
      "n_gpus": "-1",
      "owner": "mad.support@amd.com",
      "training_precision": "bf16",
      "multiple_results": "perf_pyt_mlperf_training_llama-3.1-8b.csv",
      "tags": ["pyt", "mlperf", "training", "llama3.1-8b", "real"],
      "timeout": -1,
      "args": "--model_repo pyt_mlperf_training_llama-3.1-8b",
      "additional_docker_run_options": "--privileged --group-add render --shm-size 128G --device=/dev/infiniband --cap-add IPC_LOCK --ulimit memlock=-1 -v /sys:/sys:ro -v /run/udev:/run/udev:ro"
    }
  },
  "context": {
    "docker_env_vars": {
      "MAD_SYSTEM_GPU_ARCHITECTURE": "<FILL_GPU_ARCH  gfx950 = MI355X, gfx942 = MI300X, see references/cluster-types.md>",
