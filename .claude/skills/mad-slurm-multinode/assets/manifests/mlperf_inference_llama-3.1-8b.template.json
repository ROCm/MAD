{
  "built_images": {
    "rocm-mlperf-inference-llama31-8b": {
      "model": "pyt_mlperf_inference_llama-3.1-8b",
      "docker_image": "rocm/pyt_mlperf_inference:<FILL_IMAGE_TAG e.g. vllm0271-gfx950>",
      "dockerfile": "docker/pyt_mlperf_inference.ubuntu.amd.Dockerfile",
      "base_docker": "vllm/vllm-openai-rocm:v0.27.1",
      "build_duration": 0,
      "local_image": true,
      "registry_image": null,
      "registry": null,
      "gpu_vendor": "AMD"
    }
  },
  "built_models": {
    "rocm-mlperf-inference-llama31-8b": {
      "name": "pyt_mlperf_inference_llama-3.1-8b",
      "url": "",
      "dockerfile": "docker/pyt_mlperf_inference",
      "scripts": "scripts/pyt_mlperf_inference/run.sh",
      "n_gpus": "-1",
      "owner": "mad.support@amd.com",
      "training_precision": "bf16",
      "multiple_results": "perf_pyt_mlperf_inference_llama-3.1-8b.csv",
      "tags": ["pyt", "mlperf", "inference", "llama3.1-8b", "real"],
      "timeout": -1,
      "args": "--model_repo pyt_mlperf_inference_llama-3.1-8b",
      "additional_docker_run_options": "--privileged --group-add render --shm-size 64G --security-opt seccomp=unconfined"
    }
  },
  "context": {
    "docker_env_vars": {
      "MAD_SYSTEM_GPU_ARCHITECTURE": "<FILL_GPU_ARCH  gfx950 = MI355X, gfx942 = MI300X, see references/cluster-types.md>",
      "MLPERF_INF_MODEL_PATH": "/model",
      "MLPERF_INF_DATASET_PATH": "/dataset/sample_cnn_eval_5000.json",
      "MLPERF_INF_SCENARIO": "Offline",
      "MLPERF_INF_LG_MODEL_NAME": "llama3_1-8b-edge",
      "MLPERF_INF_TOTAL_SAMPLE_COUNT": "5000",
      "MLPERF_INF_TENSOR_PARALLEL_SIZE": "8",
      "MLPERF_INF_OFFLINE_TARGET_QPS": "<FILL_OFFLINE_TARGET_QPS  expected samples/s of the whole node, must be >= what the run achieves or loadgen marks it INVALID; 40 held for one 8x MI355X node at TP=8>",
      "MLPERF_INF_RUN_PERFORMANCE": "1",
      "MLPERF_INF_RUN_ACCURACY": "1"
    },
    "docker_mounts": {
      "/model": "<FILL_DATA_ROOT>/mlperf_inference_llama3_1_8b/model/Llama-3.1-8B-Instruct",
      "/dataset": "<FILL_DATA_ROOT>/mlperf_inference_llama3_1_8b/dataset"
    },
    "docker_build_arg": {
      "BASE_DOCKER": "vllm/vllm-openai-rocm:v0.27.1"
    },
    "gpu_vendor": "AMD",
    "guest_os": "UBUNTU",
    "docker_gpus": "0,1,2,3,4,5,6,7"
  },
  "credentials_required": [],
  "summary": {
    "successful_builds": [],
    "failed_builds": [],
    "total_build_time": 0,
    "successful_pushes": [],
    "failed_pushes": []
  },
  "deployment_config": {
    "target": "slurm",
    "slurm": {
      "partition": "<FILL_PARTITION>",
      "account": "<FILL_ACCOUNT or remove if cluster has none>",
      "qos": "<FILL_QOS or remove if cluster has none>",
      "nodes": 1,
      "gpus_per_node": 8,
      "time": "04:00:00",
      "output_dir": "./slurm_output",
      "exclusive": true,
      "network_interface": "<FILL_IFNAME  management iface, see references/cluster-types.md>",
      "skip_gpus_directive": true
    },
    "distributed": {
      "launcher": "vllm",
      "nnodes": 1,
      "nproc_per_node": 8
    },
    "env_vars": {
      "HF_HOME": "${HF_HOME}",
      "XDG_CACHE_HOME": "${XDG_CACHE_HOME}",
      "PIP_CACHE_DIR": "${PIP_CACHE_DIR}",
      "MAD_DATAHOME": "${MAD_DATAHOME}"
    },
    "debug": false,
    "docker_gpus": "0,1,2,3,4,5,6,7"
  }
}
