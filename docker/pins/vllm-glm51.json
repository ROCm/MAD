{
  "name": "vllm-glm51",
  "engine": "vllm",
  "replaces": "docker/vllm_disagg_inference.glmv5.1.ubuntu.amd.Dockerfile",
  "about": "GLM-5.1-FP8 disaggregated stack: MoRI 624002c, AITER with the ROCm/aiter#4957 gqa64 fix, vLLM for GLM-5.1, vllm-router; MoRI-EP only by default.",
  "gpu_archs": [
    "gfx942"
  ],
  "base_image": {
    "gfx942": "rocm/vllm-dev:ci_base-dedbf6be8b1afa17a6220473b9c8c98242ac1c03@sha256:c513ec5e374842bc85b6757dac120385303cad7cbf1882907eb26f2d33b66d56"
  },
  "build": {
    "max_jobs": 32,
    "nic_arch": "cx7",
    "pip_constraints": []
  },
  "components": {
    "mori": {
      "repo": "https://github.com/ROCm/mori.git",
      "commit": "624002c897a30928ec04c14fc167bf2b8a93f6ce",
      "ref": "624002c897a3"
    },
    "aiter": {
      "repo": "https://github.com/ROCm/aiter.git",
      "commit": "1d872fa07aadfcbb199851fe17e6822efaceca61",
      "patches": [
        {
          "file": "aiter/gqa64.patch",
          "sha256": "a5b9c3e4b2c823c21fb24ee81ff7f1993571b52ad88b15d02124264687b85b5f",
          "upstream": "ROCm/aiter#4957"
        }
      ],
      "fork_commit": "624e43586bbdb33617812ff1de5abce83d42db65",
      "flydsl": {
        "version": "0.3.1",
        "pip_flags": [
          "--no-deps",
          "-U"
        ]
      },
      "fork_ref": "624e43586b",
      "why": "AITER with ROCm/aiter#4957 (gqa64). Carried as a patch on upstream until it is merged there."
    },
    "vllm": {
      "repo": "https://github.com/vllm-project/vllm.git",
      "commit": "d626108b1841888ec90aced33367149a6bbc7e4b",
      "patches": [
        {
          "file": "vllm/glm51.patch",
          "sha256": "589467a471532a9750a7eccbc488cdb02d71649a463d4a29fe64923af9586bc5",
          "upstream": "not yet proposed upstream"
        }
      ],
      "fork_commit": "094820b5deeb1b93733586ca8942589e385a25dc",
      "why": "vLLM for GLM-5.1 disaggregated serving. Carried as a patch on upstream."
    },
    "router": {
      "repo": "https://github.com/vllm-project/router.git",
      "commit": "1d10e71fb7bb4c0adc9f2c16ec77bf5dd4aa1586",
      "patches": [
        {
          "file": "router/dp-rank-kv-notify.patch",
          "sha256": "4c8531f15317601e25cf72b5a2bef6790a1fcfd49f9d9ca606adaa6db0c19ed0",
          "upstream": "vllm-project/router#181"
        }
      ],
      "fork_commit": "82dc9811af17412e6e24b5942a5486bc502df23a",
      "rust_toolchain": "1.88.0",
      "fork_ref": "ravgupta/discovery-dp-rank-roundrobin",
      "why": "vllm-router with DP-rank round-robin (11841c0d) and the 2P2D KV-notify fix (remote_dp_rank_override + remote_dp_size); without the latter 2P2D EP=16 wedges with 'remote blocks never arrived'. Carried as a patch on upstream until it is merged there."
    },
    "transports": {
      "enabled": false,
      "why": "UCX + RIXL (+python) + rocSHMEM + DeepEP for the rixl connector (NIXL TP, DeepEP wideEP). Off builds a MoRI-EP-only image.",
      "subcomponents": {
        "ucx": {
          "repo": "https://github.com/ROCm/ucx.git",
          "commit": "da3fac2afcb55df7605f619ee19b37f4505bd4e4",
          "ref": "da3fac2a"
        },
        "googletest": {
          "tarball": "https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz",
          "why": "RIXL build dependency"
        },
        "rixl": {
          "repo": "https://github.com/ROCm/RIXL.git",
          "commit": "f33a5599400eb8da47ecdad20111ccb35b41a709",
          "ref": "f33a5599"
        },
        "rocshmem": {
          "repo": "https://github.com/ROCm/rocm-systems.git",
          "commit": "9c43b23229cf2f835b838f72c0d1af3d4876167c",
          "why": "Parent of rocm-systems 16dc5673 (2026-09-25), whose scoped float/double atomics this ROCm 7.2 compiler rejects; the rocSHMEM these images last built with. The legacy GLM image cloned rocm-systems develop, which no longer builds; the stack is off by default there."
        },
        "deepep": {
          "repo": "https://github.com/ROCm/DeepEP.git",
          "commit": "0f63d3e97f0e43b47926179d7f3f304b3bc9554e",
          "ref": "default branch",
          "why": "the legacy images cloned the default branch with no ref; its tip on 2026-11-03 (last commit 2026-06-30)"
        }
      }
    }
  }
}
