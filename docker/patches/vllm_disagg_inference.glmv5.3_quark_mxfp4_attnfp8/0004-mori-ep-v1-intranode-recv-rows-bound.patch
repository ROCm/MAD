+class _CapacityMoriOp:
+    """Dispatch returns MoRI's capacity-sized receive buffers."""
+
+    def __init__(self, capacity):
+        self.recv_a1 = torch.zeros(capacity, 4, dtype=torch.uint8)
+        self.recv_scale = torch.zeros(capacity, 2, dtype=torch.uint8)
+        self.recv_weights = torch.zeros(capacity, 2)
+        self.recv_ids = torch.zeros(capacity, 2, dtype=torch.int32)
+
+    def dispatch(self, a1, weights, scale, indices):
+        recv = (self.recv_a1, self.recv_weights, self.recv_scale, self.recv_ids)
+        return (*recv, torch.tensor([3], dtype=torch.int32))
+
+
+@pytest.mark.parametrize(
+    "bound_recv_rows,num_tokens_across_dp,rows",
+    [
+        # IntraNode: 4 dispatchers over 4 DP ranks send 6 tokens, rounded to 32.
+        (True, [2, 3, 1, 0], 32),
+        (True, [100, 0, 0, 0], 128),
+        (True, None, 256),
+        # InterNode keeps the full receive buffer.
+        (False, [2, 3, 1, 0], 256),
+    ],
+)
+def test_mori_receive_rows_are_bounded_on_intranode(
+    monkeypatch, bound_recv_rows, num_tokens_across_dp, rows
+):
+    from vllm.model_executor.layers.fused_moe.prepare_finalize import mori_epv2
+
+    mori_module = _import_mori_prepare_finalize(monkeypatch)
+    dp_metadata = None
+    if num_tokens_across_dp is not None:
+        counts = torch.tensor(num_tokens_across_dp)
+        dp_metadata = SimpleNamespace(num_tokens_across_dp_cpu=counts)
+    ctx = SimpleNamespace(dp_metadata=dp_metadata)
+    monkeypatch.setattr(mori_epv2, "is_forward_context_available", lambda: True)
+    monkeypatch.setattr(mori_epv2, "get_forward_context", lambda: ctx)
+    monkeypatch.setattr(
+        mori_epv2, "get_dp_group", lambda: SimpleNamespace(rank_in_group=0)
+    )
+    op = _CapacityMoriOp(capacity=256)
+    adapter = mori_module.MoriPrepareAndFinalize(
+        op, 64, num_dispatchers=4, bound_recv_rows=bound_recv_rows
+    )
+    a1, scale, meta, ids, weights = adapter.prepare(
+        torch.zeros(2, 4),
+        torch.ones(2, 2),
+        torch.zeros(2, 2, dtype=torch.int32),
+        num_experts=8,
+        expert_map=None,
+        apply_router_weight_on_input=False,
+        quant_config=SimpleNamespace(),
+    )
+    pairs = [
+        (a1, op.recv_a1),
+        (scale, op.recv_scale),
+        (ids, op.recv_ids),
+        (weights, op.recv_weights),
+    ]
+    for t, buf in pairs:
+        assert t.shape[0] == rows
+        assert t.data_ptr() == buf.data_ptr()
+    assert int(meta.expert_num_tokens) == 3
