index d19b608567..17fa7d9bb6 100644
--- a/vllm/model_executor/layers/fused_moe/prepare_finalize/mori_epv2.py
+++ b/vllm/model_executor/layers/fused_moe/prepare_finalize/mori_epv2.py
@@ -20,6 +20,42 @@ logger = init_logger(__name__)
 _RECV_ROW_ALIGN = 32
 
 
+def mori_recv_rows_bound(a1: torch.Tensor, capacity: int, num_dispatchers: int) -> int:
+    """Host-side upper bound on the rows this rank can receive this step.
+
+    MORI receives each source token at most once per rank, so the receive
+    count is at most the tokens all dispatchers send: the sum of the DP
+    batches, times the dispatchers per DP rank (each TP rank may send the
+    same batch). Slicing the capacity-sized buffers (world_size *
+    max_num_tokens rows) to this bound keeps the experts, and EPv2's row
+    masking and combine copy-in, off the unused tail. The bound is rounded up
+    to a multiple of _RECV_ROW_ALIGN to limit the distinct expert shapes.
+    """
+    dp_meta = (
+        get_forward_context().dp_metadata if is_forward_context_available() else None
+    )
+    if dp_meta is None:
+        return capacity
+    tokens = dp_meta.num_tokens_across_dp_cpu
+    n_dp = tokens.numel()
+    dp_rank = get_dp_group().rank_in_group
+    if dp_rank >= n_dp or a1.shape[0] > int(tokens[dp_rank]):
+        # Metadata that does not cover this rank's own batch is stale; a
+        # bound derived from it could cut off received rows.
+        logger.debug_once(
+            "MORI: DP token counts do not cover this rank's batch; "
+            "using the full receive buffer."
+        )
+        return capacity
+    if n_dp > 0 and num_dispatchers % n_dp == 0:
+        bound = num_dispatchers // n_dp * int(tokens.sum())
+    else:
+        bound = num_dispatchers * int(tokens.max())
+    bound = max(bound, 1)
+    bound = -(-bound // _RECV_ROW_ALIGN) * _RECV_ROW_ALIGN
+    return min(capacity, bound)
+
+
