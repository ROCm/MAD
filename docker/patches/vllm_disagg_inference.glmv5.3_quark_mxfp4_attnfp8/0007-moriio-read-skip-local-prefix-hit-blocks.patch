+@pytest.mark.usefixtures("restore_moriio_role")
+@pytest.mark.parametrize(
+    "local_hit,external,first_block",
+    # 96 prompt tokens; READ imports [0, 95). (64, 16): load trimmed below a block.
+    [(0, 95, 0), (64, 31, 4), (80, 15, 5), (64, 16, 4)],
+)
+def test_glm5_mtp3_read_skips_blocks_of_the_local_prefix_hit(
+    local_hit, external, first_block
+):
+    """Non-hybrid MLA + indexer READ: D reads only blocks past its prefix hit."""
+    specs: dict[str, KVCacheSpec] = {}
+    for i in range(3):
+        specs[f"layers.{i}.attn"] = MLAAttentionSpec(
+            block_size=16, num_kv_heads=1, head_size=576, dtype=torch.bfloat16
+        )
+        specs[f"layers.{i}.indexer"] = MLAAttentionSpec(
+            block_size=16, num_kv_heads=1, head_size=132, dtype=torch.uint8
+        )
+    layout_config = SimpleNamespace(
+        scheduler_config=SimpleNamespace(disable_hybrid_kv_cache_manager=False),
+        parallel_config=SimpleNamespace(pipeline_parallel_size=1),
+        speculative_config=None,
+        cache_config=SimpleNamespace(
+            get_resolved_kv_cache_layout=lambda: KVCacheLayout.BLHNC
+        ),
+    )
+    config = KVCacheConfig(
+        num_blocks=64,
+        kv_cache_tensors=[],
+        kv_cache_groups=get_kv_cache_groups(layout_config, specs),
+    )
+    vllm_config = _gate_vllm_config(
+        speculative_config=_spec_config("mtp"),
+        num_lookahead_tokens=3,
+        num_speculative_tokens=3,
+    )
+    sched = moriio_connector.MoRIIOConnectorScheduler(vllm_config, "engine", config)
+    request = _make_read_request([list(range(10, 16))], num_prompt_tokens=96)
+    assert sched.get_num_new_matched_tokens(request, local_hit)[0] >= external
+
+    # D's table ends in one MTP lookahead block that has no remote source.
+    sched.update_state_after_alloc(
+        request, _FakeBlocks((list(range(100, 107)),)), external
+    )
+
+    meta = sched.build_connector_meta(SchedulerOutput.make_empty()).reqs_to_recv
+    assert meta["req"].local_block_ids == [list(range(100 + first_block, 106))]
+    assert meta["req"].remote_block_ids == [list(range(10 + first_block, 16))]
+
+
