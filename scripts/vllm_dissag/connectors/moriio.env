# Platform-mandatory runtime env for the moriio (MoRIIO) connector on the
# ROCm-7.2.3 / mori121 image. Applies to ALL moriio runs (TP and wideEP, every model).
#
# These must reach the container at PID 1 — PyTorch reads the alloc-conf at import,
# so a late shell export inside the launcher is too late. The slurm sources this file
# after resolving CONNECTOR and forwards each KEY=VALUE via `docker -e`.
#
# Why: ROCm 7.2.3 cannot dmabuf-export HIP-VMM memory. With expandable_segments ON,
# the KV cache is VMM-backed and MoRI RegisterRdmaMemoryRegion EFAULTs (errno 14) on
# the first disagg WRITE -> every request 500s. expandable_segments must be False on
# BOTH allocators, legacy HSA IPC off (so the dmabuf path is used), arch pinned.
# Override any of these at submit time by exporting the same name before sbatch.
PYTORCH_ALLOC_CONF=expandable_segments:False
PYTORCH_HIP_ALLOC_CONF=expandable_segments:False
HSA_ENABLE_IPC_MODE_LEGACY=0
MORI_GPU_ARCHS=gfx942
HSA_NO_SCRATCH_RECLAIM=1

# MoRI / RDMA fabric tuning. Validated on OCI MI300X RoCEv2; these are cluster-specific
# (GID index, traffic class, QP counts) — override per-fabric by exporting the same name
# before sbatch. Kept here (not baked in the image) so a different cluster needs no rebuild.
MORI_RDMA_TC=41
MORI_RDMA_SL=0
MORI_IO_SL=1
MORI_IB_ENABLE_RELAXED_ORDERING=1
MORI_IB_GID_INDEX=1
MORI_NUM_QP_PER_PE=8
VLLM_MORIIO_QP_PER_TRANSFER=2
VLLM_MORIIO_NUM_WORKERS=4
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=1
