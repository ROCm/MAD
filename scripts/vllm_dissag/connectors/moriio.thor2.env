# Per-fabric profile: Broadcom Thor2 (BCM57608, bnxt_re) RoCEv2.
#
# Layered ON TOP OF connectors/moriio.env by run_xPyD_models.slurm when
# FABRIC_PROFILE=thor2 is set. Only the keys that differ from the CX7 baseline are
# here; everything else (alloc-conf block, MORI_IB_GID_INDEX=3, MORI_IO_SL=1,
# relaxed ordering, VLLM_MORIIO_*) is inherited unchanged from moriio.env.
#
# Precedence, unchanged from PR #176's design: image-baked < moriio.env < this file
# < a submit-time `export KEY=...`. Nothing here edits moriio.env, so a CX7 cluster
# that never sets FABRIC_PROFILE sees byte-identical behaviour.
#
# Validated on skyRiver: 4x MI308X (gfx942), 8x dual-port BCM57608 bonded
# (bond0..bond7, 802.3ad, MTU 9000), bnxt_en 1.10.3-238.1.165.0 / bnxt_re
# 238.1.165.0 / NIC FW 238.1.168.0. GLM-5.2-FP8 at 1P/1D (EP8) and 2P/2D (EP16).

# --- RDMA NIC allowlist ------------------------------------------------------
# Broadcom device names, not mlx5. THIS LIST IS A FALLBACK ONLY. The bnxt_re
# device name <-> fabric rail mapping is scrambled per node AND MOVES ACROSS
# REBOOTS (e.g. rail 192.168.200.0/24 was bnxt_re_bond4 on one node and
# bnxt_re_bond1 on another; after a reboot those became bond6 and bond4). MoRI
# pairs peers POSITIONALLY -- rank i's i-th device talks to rank j's i-th device --
# so a name-sorted list crosses rails and dies at bnxt.cpp:417 ModifyInit2Rtr
# ("DV Modify QP v2 error 110"). Resolve the real order live from
#   /sys/class/infiniband/<dev>/device/net/<slave> -> bond master -> IPv4 3rd octet
# and export MORI_RDMA_DEVICES at submit time (launch_disagg_skyriver.sh does this
# automatically). Never trust the order below on a machine you have not checked.
MORI_RDMA_DEVICES=bnxt_re_bond0,bnxt_re_bond1,bnxt_re_bond2,bnxt_re_bond3,bnxt_re_bond4,bnxt_re_bond5,bnxt_re_bond6,bnxt_re_bond7
# NCCL/RCCL is the opposite case: it picks its device per node by PCI locality and
# does NOT coordinate across nodes, so handing it all 8 lets it choose a different
# rail on each node -> ibvwrap.cc:302 "ibv_modify_qp failed with 110" ->
# ncclCommInitRank fails in the DP group. Give it exactly ONE rail, the same rail on
# every node (the launcher pins this per node; the list here is the inert fallback).
NCCL_IB_HCA=bnxt_re_bond0

# --- QoS / traffic class -----------------------------------------------------
# MORI_RDMA_TC is the ENCODED byte: DSCP << 2 | ECN. 104 = DSCP 26 (AF31) with ECN
# bits clear -- the same value MoRI's own MI325X_BNXT CI lane uses. NCCL_IB_TC takes
# the RAW value instead of the encoded one, so the two numbers below are NOT a typo:
# they mark the same class through two different APIs. SL 3 is the Broadcom RoCE
# default priority; NCCL stays on SL 0 with the CX7 baseline value.
MORI_RDMA_TC=104
MORI_RDMA_SL=3
NCCL_IB_TC=41
NCCL_IB_SL=0
# HOST-SIDE DSCP MARKING ONLY. These set the marking on egress; they do NOT and MUST
# NOT touch PFC/ETS/DCB. As found on this fabric: PFC disabled on every bond, all 8
# priorities mapped to TC 0, no dcb app rules. Configuring host-side lossless without
# the matching switch-side config is how you get a silently wedged fabric -- do not
# add `dcb pfc`/`dcb ets`/`dcb app` writes here or anywhere in this tree.

# --- QP fan-out --------------------------------------------------------------
# 4, not the CX7 baseline's 8. Thor2's DirectVerbs path allocates one QP per PE per
# device; at EP16 with 8 devices the x8 setting multiplies out far enough to slow QP
# establishment without buying bandwidth. 4 also matches the script default.
MORI_NUM_QP_PER_PE=4

# --- Control-plane sockets ---------------------------------------------------
# There is no `eth0` here; the CX7 baseline's value does not exist on this platform
# and gloo/NCCL bootstrap would fail to bind. bond0 is the fabric control iface.
# NOTE: on a node whose management NIC is on a separate subnet, point these at the
# MANAGEMENT iface instead (vLLM DP resolves mq_connect_ip there and gloo returns
# nfds=-1 on the bonded fabric iface) -- launch_disagg_skyriver.sh resolves it live.
# RDMA data-plane traffic is unaffected either way; it follows MORI_RDMA_DEVICES.
MORI_SOCKET_IFNAME=bond0
NCCL_SOCKET_IFNAME=bond0
GLOO_SOCKET_IFNAME=bond0

# --- NOT set here, on purpose ------------------------------------------------
# GPU_MEMORY_UTILIZATION: EP16 needs ~0.72 (the MoRI symmetric heap is allocated
#   OUTSIDE PyTorch's pool, so a 32 GiB heap eats what 0.80 leaves free and the
#   cudagraph warm-up OOMs). It is deliberately NOT in this file: it is a recipe key
#   (models.yaml `env:`), and a value arriving via a connector .env is silently
#   overridden by models.yaml inside the container. Export it at submit time --
#   `export GPU_MEMORY_UTILIZATION=0.72` -- which is the one tier that wins.
#   It is also an EP-size property, not a fabric one, so it does not belong here.
# MORI_IB_GID_INDEX: already 3 in moriio.env, and 3 is RoCEv2 on Thor2 too.
