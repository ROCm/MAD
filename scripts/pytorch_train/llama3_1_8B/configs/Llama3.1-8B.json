{
  "model":{
      "num_layers": 32,
      "num_heads": 32,
      "num_kv_heads": 8,
      "embedding_dim": 4096,
      "max_seq_len": 8192,
      "vocab_size": 128256,
      "eps": 1e-05,
      "hidden_dim": 14336
  },
  "training":{
      "seed": 1024,
      "batch_size": 3,
      "total_steps": 120,
      "grad_acc_steps": 8
  },
  "optimizer":{
      "type": "Adam",
      "params":{
          "lr": 0.001,
          "betas": [0.9, 0.999],
          "weight_decay": 0.0001,
          "fused": true
      }
  },
  "scheduler":{
      "type": "StepLR",
      "params":{
          "step_size": 5,
          "gamma": 0.1
      }
  }
}