# In-container defaults for the SGLang MoRI launcher, read by mori_ep_env.sh as
# `export KEY="${KEY:-VALUE}"`: the weakest layer, under everything the launcher
# forwards (see docs/configuration.md, "The container environment"). The values
# that depend on something -- the NIC set (USE_CX7_NICS), the socket interface
# (default route), MoRI's GID (NCCL's), DP_MODE-only MoRI EP tuning -- stay in
# mori_ep_env.sh. One KEY=VALUE per line; no quoting, no expansion.

# RoCE v2 with IPv4 routing (GID index 3 is typical)
NCCL_IB_GID_INDEX=3
# Allow NCCL to use multiple NICs per GPU when beneficial
NCCL_CROSS_NIC=1
# GPUDirect RDMA - level 3 enables PXB (PCI Bridge) crossing
NCCL_NET_GDR_LEVEL=3
# Use IB transport (force IB over Socket)
NCCL_IB_DISABLE=0
# Multiple QPs per connection for CX7 (default 1, recommend 4-8)
NCCL_IB_QPS_PER_CONNECTION=4
# Split data across QPs for better load balancing
NCCL_IB_SPLIT_DATA_ON_QPS=1
# 8 MB chunks to use NDR 400G bandwidth (default 128 KB)
NCCL_BUFFSIZE=8388608
# IB operation timeout and retries (larger clusters)
NCCL_IB_TIMEOUT=22
NCCL_IB_RETRY_CNT=7
# Service Level for QoS (SL-based fabrics)
NCCL_IB_SL=0
# Traffic Class for RoCE QoS: DSCP 26 (AF31) << 2
NCCL_IB_TC=106
NCCL_IB_PCI_RELAXED_ORDERING=1
# Adaptive routing (if the fabric supports it)
NCCL_IB_ADAPTIVE_ROUTING=1
NCCL_TOPO_DUMP_FILE=/tmp/nccl_topo.xml
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
# QPs per connection for MoRI (same reasoning as NCCL)
MORI_QPS_PER_CONNECTION=4
# Timeouts for larger fabrics
GLOO_TIMEOUT_MS=300000
TORCH_DIST_INIT_BARRIER_TIMEOUT=300
SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT=1200
SGLANG_DISAGGREGATION_WAITING_TIMEOUT=1200
# Runtime
PYTHONDONTWRITEBYTECODE=1
SGLANG_USE_AITER=1
SGLANG_ROUTER_STDOUT_LOGS=0
